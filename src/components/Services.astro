---
import { services } from '../data/site';
---

<section id="services" class="bg-asphalt py-24 lg:py-32">
	<div class="mx-auto max-w-7xl px-6 lg:px-10">
		<div class="max-w-3xl">
			<p class="kicker kicker-rule mb-6">What We Do</p>
			<h2 class="font-display text-4xl font-bold uppercase leading-tight tracking-tight text-cream lg:text-6xl">
				Full site work,<br class="hidden sm:block" /> one crew from start to finish.
			</h2>
			<p class="mt-6 max-w-xl text-lg leading-relaxed text-dust">
				From the first cut of dirt to the last pour of concrete, we handle it
				ourselves — no subcontractors juggling your schedule.
			</p>
		</div>

		<div class="mt-16 grid gap-px border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
			{services.map((service) => (
				<div class="group bg-panel p-9 transition-colors duration-300 hover:bg-steel">
					<span class="flex h-12 w-12 items-center justify-center border border-line text-amber transition-colors group-hover:border-amber">
						<svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" stroke-linejoin="miter">
							<path d={service.icon} />
						</svg>
					</span>
					<h3 class="mt-7 font-display text-xl font-semibold uppercase tracking-wide text-cream">
						{service.title}
					</h3>
					<p class="mt-3 text-[0.95rem] leading-relaxed text-dust">{service.copy}</p>
				</div>
			))}
		</div>
	</div>
</section>

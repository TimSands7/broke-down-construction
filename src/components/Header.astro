---
import { Image } from 'astro:assets';
import { site, nav } from '../data/site';
import logo from '../assets/logo.png';
---

<header
	id="site-header"
	class="fixed inset-x-0 top-0 z-50 transition-colors duration-300 border-b border-transparent"
>
	<div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-3 lg:px-10">
		<!-- Wordmark -->
		<a href="#top" class="group flex items-center gap-3" aria-label={`${site.name} home`}>
			<Image src={logo} alt="" width={44} height={44} class="h-11 w-11 shrink-0" />
			<span class="font-display text-lg font-semibold uppercase leading-none tracking-[0.14em] text-cream">
				Broke Down<span class="text-amber"> Construction</span>
			</span>
		</a>

		<!-- Desktop nav -->
		<nav class="hidden items-center gap-9 lg:flex">
			{nav.map((item) => (
				<a
					href={item.href}
					class="font-display text-sm font-medium uppercase tracking-[0.18em] text-dust transition-colors hover:text-amber"
				>
					{item.label}
				</a>
			))}
		</nav>

		<div class="hidden items-center gap-5 lg:flex">
			<a
				href={site.phoneHref}
				class="font-display text-base font-medium tracking-wide text-cream transition-colors hover:text-amber"
			>
				{site.phone}
			</a>
			<a
				href="#contact"
				class="border border-amber bg-amber px-5 py-2.5 font-display text-sm font-semibold uppercase tracking-[0.18em] text-asphalt transition-colors hover:bg-amber-bright"
			>
				Free Estimate
			</a>
		</div>

		<!-- Mobile toggle -->
		<button
			id="nav-toggle"
			class="flex h-10 w-10 items-center justify-center text-cream lg:hidden"
			aria-label="Open menu"
			aria-expanded="false"
			aria-controls="mobile-nav"
		>
			<svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square">
				<path d="M4 7h16M4 12h16M4 17h16" />
			</svg>
		</button>
	</div>

	<!-- Mobile nav panel -->
	<div
		id="mobile-nav"
		class="hidden border-t border-line bg-panel/98 backdrop-blur lg:hidden"
	>
		<nav class="flex flex-col px-6 py-4">
			{nav.map((item) => (
				<a
					href={item.href}
					class="border-b border-line/70 py-3.5 font-display text-base font-medium uppercase tracking-[0.18em] text-dust transition-colors hover:text-amber"
				>
					{item.label}
				</a>
			))}
			<a
				href={site.phoneHref}
				class="mt-5 border border-amber bg-amber px-5 py-3 text-center font-display text-sm font-semibold uppercase tracking-[0.18em] text-asphalt"
			>
				Call {site.phone}
			</a>
		</nav>
	</div>
</header>

<script>
	const header = document.getElementById('site-header');
	const toggle = document.getElementById('nav-toggle');
	const panel = document.getElementById('mobile-nav');

	// Solidify header background once the user scrolls past the hero fold.
	const onScroll = () => {
		if (!header) return;
		if (window.scrollY > 24) {
			header.classList.add('bg-asphalt/92', 'backdrop-blur', 'border-line');
		} else {
			header.classList.remove('bg-asphalt/92', 'backdrop-blur', 'border-line');
		}
	};
	onScroll();
	window.addEventListener('scroll', onScroll, { passive: true });

	// Mobile menu toggle.
	toggle?.addEventListener('click', () => {
		const isOpen = panel?.classList.toggle('hidden') === false;
		toggle.setAttribute('aria-expanded', String(isOpen));
		toggle.setAttribute('aria-label', isOpen ? 'Close menu' : 'Open menu');
	});

	// Close the mobile menu after tapping a link.
	panel?.querySelectorAll('a').forEach((link) => {
		link.addEventListener('click', () => {
			panel.classList.add('hidden');
			toggle?.setAttribute('aria-expanded', 'false');
		});
	});
</script>

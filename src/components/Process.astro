---
const steps = [
	{
		title: 'Call or Email',
		copy: "Tell us what you're looking at — grading, concrete, a fence, a tree that has to come down. We'll ask a few questions and set a time to look at it.",
	},
	{
		title: 'Walk the Site',
		copy: "We come out, walk the property, and give you a straight number before anything gets scheduled. No surprises once equipment shows up.",
	},
	{
		title: 'Get It Done',
		copy: 'Our own crew and our own trucks handle the job start to finish — no subcontractors, no waiting on someone else\'s schedule.',
	},
];
---

<section id="process" class="border-t border-line bg-asphalt py-24 lg:py-32">
	<div class="mx-auto max-w-7xl px-6 lg:px-10">
		<div class="max-w-2xl">
			<p class="kicker kicker-rule mb-6">How It Works</p>
			<h2 class="font-display text-4xl font-bold uppercase leading-tight tracking-tight text-cream lg:text-6xl">
				Three steps, no runaround
			</h2>
		</div>

		<div class="mt-16 grid gap-px border border-line bg-line md:grid-cols-3">
			{steps.map((step, i) => (
				<div class="bg-asphalt p-8 lg:p-9">
					<span class="font-display text-5xl font-bold text-steel">
						{String(i + 1).padStart(2, '0')}
					</span>
					<h3 class="mt-5 font-display text-xl font-semibold uppercase tracking-wide text-cream">
						{step.title}
					</h3>
					<p class="mt-3 text-[0.95rem] leading-relaxed text-dust">{step.copy}</p>
				</div>
			))}
		</div>
	</div>
</section>

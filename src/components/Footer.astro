---
import { Image } from 'astro:assets';
import { site, nav } from '../data/site';
import logo from '../assets/logo.png';

const year = new Date().getFullYear();
---

<footer class="border-t border-line bg-panel">
	<div class="mx-auto max-w-7xl px-6 py-16 lg:px-10">
		<div class="flex flex-col gap-12 lg:flex-row lg:justify-between">
			<!-- Brand -->
			<div class="max-w-sm">
				<a href="#top" class="flex items-center gap-3">
					<Image src={logo} alt="" width={40} height={40} class="h-10 w-10 shrink-0" />
					<span class="font-display text-lg font-semibold uppercase tracking-[0.14em] text-cream">
						Broke Down<span class="text-amber"> Construction</span>
					</span>
				</a>
				<p class="mt-5 leading-relaxed text-dust">
					Grading, concrete, tree removal, land clearing, and site work based
					in {site.city}.
				</p>
			</div>

			<!-- Links + contact -->
			<div class="grid grid-cols-2 gap-12 sm:grid-cols-3">
				<div>
					<h3 class="font-display text-xs font-semibold uppercase tracking-[0.22em] text-clay">Explore</h3>
					<ul class="mt-5 space-y-3">
						{nav.map((item) => (
							<li>
								<a href={item.href} class="text-dust transition-colors hover:text-amber">{item.label}</a>
							</li>
						))}
					</ul>
				</div>
				<div>
					<h3 class="font-display text-xs font-semibold uppercase tracking-[0.22em] text-clay">Contact</h3>
					<ul class="mt-5 space-y-3">
						<li><a href={site.phoneHref} class="text-dust transition-colors hover:text-amber">{site.phone}</a></li>
						<li><a href={`mailto:${site.email}`} class="text-dust transition-colors hover:text-amber">{site.email}</a></li>
					</ul>
				</div>
				<div>
					<h3 class="font-display text-xs font-semibold uppercase tracking-[0.22em] text-clay">Based In</h3>
					<address class="mt-5 not-italic leading-relaxed text-dust">
						{site.city}<br />
						2-hour service radius
					</address>
				</div>
			</div>
		</div>

		<div class="mt-14 flex flex-col gap-4 border-t border-line pt-8 sm:flex-row sm:items-center sm:justify-between">
			<p class="font-display text-xs uppercase tracking-[0.18em] text-clay">
				© {year} {site.legalName}. All rights reserved.
			</p>
			<p class="font-display text-xs uppercase tracking-[0.18em] text-clay">
				Free Estimates · Owner-Operated
			</p>
		</div>
	</div>
</footer>
